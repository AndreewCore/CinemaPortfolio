---
import { navLinks } from '../data/site';
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-tinta/10 bg-crema/85 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
    <a href="#inicio" class="font-display text-3xl uppercase tracking-wide"><span class="text-verde">E</span>&nbsp;Jordan</a>

    <ul class="hidden gap-8 text-sm font-bold uppercase tracking-[0.15em] md:flex">
      {navLinks.map((l) => (
        <li><a href={l.href} class="nav-link border-b-[3px] border-transparent py-1 transition-colors hover:text-verde aria-[current]:border-turquesa">{l.label}</a></li>
      ))}
    </ul>

    <button id="menu-btn" class="md:hidden" aria-label="Menú" aria-expanded="false" aria-controls="menu-movil">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </nav>

  <ul id="menu-movil" class="hidden flex-col gap-1 border-t border-tinta/10 px-4 pb-4 pt-2 md:hidden">
    {navLinks.map((l) => (
      <li><a href={l.href} class="block py-2 font-display text-3xl uppercase tracking-wide">{l.label}</a></li>
    ))}
  </ul>
</header>

<script>
  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('menu-movil')!;

  /** Abre o cierra el menú móvil. */
  function toggle(open: boolean) {
    menu.classList.toggle('hidden', !open);
    menu.classList.toggle('flex', open);
    btn.setAttribute('aria-expanded', String(open));
  }

  btn.addEventListener('click', () => toggle(menu.classList.contains('hidden')));
  // Al elegir una sección el menú debe cerrarse para no tapar el contenido.
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => toggle(false)));

  // Marca en el header la sección que ocupa el centro de la pantalla.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.nav-link')];
  const observer = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((l) =>
          l.getAttribute('href') === `#${e.target.id}` ? l.setAttribute('aria-current', 'true') : l.removeAttribute('aria-current'),
        );
      }
    },
    { rootMargin: '-50% 0px -50% 0px' },
  );
  links.forEach((l) => {
    const section = document.querySelector(l.getAttribute('href')!);
    if (section) observer.observe(section);
  });
</script>
