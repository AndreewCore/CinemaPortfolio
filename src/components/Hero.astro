---
import { positions } from '../data/site';
import collage from '../data/collage.json';
import { asset } from '../data/asset';

const dots = ['bg-verde', 'bg-marron', 'bg-turquesa'];
const degree = [
  { text: 'Licenciatura', bar: 'bg-verde', indent: 'mr-0' },
  { text: 'en Cine', bar: 'bg-marron', indent: 'mr-6 md:mr-10' },
  { text: 'UCSG', bar: 'bg-turquesa', indent: 'mr-12 md:mr-20' },
];
---

<section id="inicio" class="relative isolate flex h-[100svh] max-h-[1000px] min-h-[660px] flex-col overflow-hidden border-b-[6px] border-negro">
  <!-- Collage de producciones: se edita desde el panel (Inicio → Collage). -->
  <div class="absolute inset-0 -z-20 grid grid-cols-2 grid-rows-4 md:grid-cols-4 md:grid-rows-2" aria-hidden="true">
    {collage.images.slice(0, 8).map((src) => (
      <img src={asset(src)} alt="" class="h-full w-full object-cover grayscale contrast-125" />
    ))}
  </div>
  <!-- Velo crema más denso a la izquierda para que el nombre se lea sobre el collage. -->
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-crema via-crema/90 to-crema/60" aria-hidden="true"></div>
  <div class="absolute inset-0 -z-10 bg-marron/10 mix-blend-multiply" aria-hidden="true"></div>

  <img
    src={asset('/img/camera-tripod.png')}
    alt=""
    class="tripod pointer-events-none absolute -bottom-[3%] right-[-14%] -z-10 h-[78%] w-auto max-w-none sm:right-[4%] md:right-[46%] md:h-[calc(100%-4.5rem)]"
  />

  <div class="relative mx-auto flex w-full max-w-7xl flex-1 flex-col justify-center px-4 pb-40 pt-28 sm:px-6 md:pb-24">
    <h1 class="outline-crema font-display uppercase leading-[0.78] tracking-wide">
      <span class="block text-[clamp(8rem,26vw,19rem)] text-verde">E</span>
      <span class="block text-[clamp(6rem,21vw,17rem)] text-negro">Jordan</span>
    </h1>

    <ul class="mt-8 flex max-w-2xl flex-wrap gap-2">
      {positions.map((p, i) => (
        <li class="flex items-center gap-2 rounded-full bg-negro px-4 py-1.5 text-xs font-bold uppercase tracking-[0.2em] text-crema sm:text-sm">
          <span class:list={['h-2 w-2 rounded-full', dots[i % dots.length]]}></span>{p}
        </li>
      ))}
    </ul>
  </div>

  <div class="absolute bottom-8 right-4 flex flex-col items-end gap-1 sm:right-6 md:bottom-14 md:right-[max(1.5rem,calc((100vw-80rem)/2+1.5rem))]">
    {degree.map((d) => (
      <p class:list={['outline-crema flex items-center gap-3 font-display text-3xl uppercase leading-none tracking-wide text-negro sm:text-5xl', d.indent]}>
        <span class:list={['h-[6px] w-10 sm:w-16', d.bar]}></span>{d.text}
      </p>
    ))}
  </div>
</section>

<style>
  .tripod {
    /* Pivotar desde la base mantiene las patas apoyadas en el borde inferior. */
    transform-origin: 40% 100%;
    transform: rotate(12deg);
    filter: drop-shadow(0 24px 24px rgb(22 19 15 / 0.35));
    animation: settle 1.4s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  /* Contorno crema: el texto negro se separa de la cámara negra que tiene detrás. */
  .outline-crema {
    text-shadow:
      3px 0 var(--color-crema), -3px 0 var(--color-crema), 0 3px var(--color-crema), 0 -3px var(--color-crema),
      2px 2px var(--color-crema), -2px -2px var(--color-crema), 2px -2px var(--color-crema), -2px 2px var(--color-crema);
  }
  @keyframes settle {
    from { transform: rotate(0deg); opacity: 0; }
    to { transform: rotate(12deg); opacity: 1; }
  }
</style>
