---
import { areas, contact } from '../data/site';
import { inlineLogo } from '../data/logo';
import PaintBlob from './PaintBlob.astro';

const field =
  'w-full border-2 border-negro/10 bg-white/60 px-4 py-3 text-negro outline-none transition-colors placeholder:text-negro/35 hover:border-negro/25 focus:border-turquesa focus:bg-white';
const label = 'text-xs font-bold uppercase tracking-[0.2em] text-marron';

const links = [
  { kind: 'Correo', value: contact.email, href: `mailto:${contact.email}`, icon: 'mail' },
  { kind: 'Instagram', value: contact.instagram, href: contact.instagramUrl, icon: 'instagram' },
];
---

<section id="contacto" class="relative overflow-hidden bg-verde py-24 text-crema md:py-32">
  <PaintBlob color="#6B4226" rotate={30} class="pointer-events-none absolute -left-28 -top-28 h-80 w-80 opacity-50" />
  <!-- Palabra gigante solo en contorno: llena el fondo sin competir con el formulario. -->
  <span
    class="outline-word pointer-events-none absolute -bottom-[0.18em] left-1/2 -translate-x-1/2 select-none whitespace-nowrap font-display text-[clamp(8rem,26vw,24rem)] uppercase leading-none tracking-wide text-transparent"
    aria-hidden="true">Contacto</span
  >

  <div class="relative mx-auto grid max-w-7xl gap-14 px-4 sm:px-6 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
    <div class="flex flex-col justify-center">
      <h2 class="font-display text-[clamp(5rem,14vw,10rem)] uppercase leading-[0.8] tracking-wide">
        Hable<span class="text-turquesa">mos</span>
      </h2>
      <div class="mt-4 flex h-[6px] w-40" aria-hidden="true">
        <span class="flex-1 bg-turquesa"></span><span class="flex-1 bg-crema"></span><span class="flex-1 bg-marron"></span>
      </div>

      <ul class="mt-10 grid gap-3">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              target={l.icon === 'instagram' ? '_blank' : undefined}
              rel={l.icon === 'instagram' ? 'noopener' : undefined}
              class="group flex items-center gap-4 border-2 border-crema/20 p-4 transition-colors hover:border-crema hover:bg-crema hover:text-negro"
            >
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-crema text-verde transition-colors group-hover:bg-turquesa group-hover:text-negro">
                {l.icon === 'mail' ? (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
                  </svg>
                ) : (
                  <span class="h-5 w-5" set:html={inlineLogo('instagram')} />
                )}
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-xs font-bold uppercase tracking-[0.2em] text-turquesa">{l.kind}</span>
                <span class="block truncate text-lg font-medium">{l.value}</span>
              </span>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 transition-transform group-hover:translate-x-1" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="relative">
      <PaintBlob color="#3FA7A3" rotate={200} class="pointer-events-none absolute -right-10 -top-12 z-10 h-28 w-28" />
      <!-- Maqueta: al conectar, poner aquí el endpoint de Formspree o Web3Forms. -->
      <form id="contact-form" action="#" method="POST" class="relative grid gap-6 bg-crema p-6 text-negro shadow-[14px_14px_0_0_var(--color-negro)] sm:grid-cols-2 sm:p-10">
        <label class="grid gap-2">
          <span class={label}>Nombre</span>
          <input class={field} type="text" name="name" required autocomplete="name" />
        </label>
        <label class="grid gap-2">
          <span class={label}>Correo</span>
          <input class={field} type="email" name="email" required autocomplete="email" />
        </label>

        <fieldset class="sm:col-span-2">
          <legend class={label}>Proyecto</legend>
          <div class="mt-3 flex flex-wrap gap-2">
            {areas.map((p) => (
              <label class="cursor-pointer">
                <input type="checkbox" name="project" value={p} class="peer sr-only" />
                <span class="block rounded-full border-2 border-negro/15 px-4 py-1.5 text-sm font-medium transition-colors hover:border-negro peer-checked:border-negro peer-checked:bg-negro peer-checked:text-crema peer-focus-visible:ring-2 peer-focus-visible:ring-turquesa">
                  {p}
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <label class="grid gap-2 sm:col-span-2">
          <span class={label}>Mensaje</span>
          <textarea class={`${field} resize-none`} name="message" rows="5" required></textarea>
        </label>

        <button
          type="submit"
          class="group flex items-center justify-between gap-6 bg-negro px-6 py-4 font-display text-2xl uppercase tracking-wider text-crema transition-colors hover:bg-turquesa hover:text-negro sm:col-span-2"
        >
          Enviar
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform group-hover:translate-x-1" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </button>

        <p id="contact-ok" class="hidden items-center gap-3 bg-verde px-4 py-3 font-medium text-crema sm:col-span-2" role="status">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg>
          ¡Gracias! Te responderé pronto.
        </p>
      </form>
    </div>
  </div>
</section>

<style>
  .outline-word {
    -webkit-text-stroke: 2px rgb(243 233 210 / 0.12);
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const ok = document.getElementById('contact-ok')!;
  // Mientras no haya servicio de envío, se evita recargar la página.
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    form.reset();
    ok.classList.replace('hidden', 'flex');
  });
</script>
