---
import { getCollection } from 'astro:content';
import { positions } from '../data/site';
import { asset } from '../data/asset';

const videos = (await getCollection('videos')).sort((a, b) => a.data.order - b.data.order);

/** Acepta un ID o cualquier URL de YouTube y devuelve solo el ID. */
function youtubeId(value: string): string {
  const m = value.match(/(?:youtu\.be\/|v=|embed\/|shorts\/)([\w-]{11})/);
  return m ? m[1] : value.trim();
}

// Sólo se muestran pestañas de posiciones que tienen contenido.
const tabs = positions.filter((p) => videos.some((v) => v.data.position === p));
const firstOfTab = new Set(tabs.map((t) => videos.find((v) => v.data.position === t)?.id));
---

<section id="cine" class="relative overflow-hidden bg-negro py-28 text-crema md:py-36">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 class="font-display text-[clamp(3rem,15vw,11rem)] uppercase leading-[0.8] tracking-wide">
        Cinemato<span class="text-turquesa">grafía</span>
      </h2>
      <div class="flex flex-wrap gap-2" role="tablist">
        {tabs.map((p, i) => (
          <button
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            data-tab={p}
            class="tab rounded-full border-2 border-crema/25 px-5 py-2 text-sm font-bold uppercase tracking-[0.15em] transition-colors hover:border-turquesa aria-selected:border-turquesa aria-selected:bg-turquesa aria-selected:text-negro"
          >
            {p}
          </button>
        ))}
      </div>
    </div>
    <div class="mt-6 flex h-[6px]" aria-hidden="true">
      <span class="flex-1 bg-verde"></span><span class="flex-1 bg-marron"></span><span class="flex-1 bg-turquesa"></span>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2 md:gap-8">
      {videos.map((v) => (
        <article
          data-position={v.data.position}
          class:list={['card group', v.data.position !== tabs[0] && 'hidden', firstOfTab.has(v.id) && 'md:col-span-2']}
        >
          <div class="relative aspect-video overflow-hidden bg-crema/5 ring-1 ring-crema/10">
            {v.data.youtube ? (
              <button class="yt absolute inset-0" data-id={youtubeId(v.data.youtube)} aria-label={`Reproducir ${v.data.title}`}>
                <img
                  src={`https://i.ytimg.com/vi/${youtubeId(v.data.youtube)}/maxresdefault.jpg`}
                  alt=""
                  loading="lazy"
                  onload="if(this.naturalWidth<=120)this.src=this.src.replace('maxresdefault','hqdefault')"
                  onerror="this.onerror=null;this.src=this.src.replace('maxresdefault','hqdefault')"
                  class="h-full w-full object-cover opacity-80 transition duration-700 group-hover:scale-[1.03] group-hover:opacity-100"
                />
                <span class="absolute inset-0 bg-gradient-to-t from-negro/70 to-transparent"></span>
                <span class="absolute inset-0 m-auto grid h-20 w-20 place-items-center rounded-full bg-crema text-negro transition group-hover:scale-110 group-hover:bg-turquesa">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                </span>
              </button>
            ) : v.data.image ? (
              <img src={asset(v.data.image)} alt={v.data.title} loading="lazy" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]" />
            ) : null}
          </div>
          <div class="mt-4 flex items-baseline justify-between gap-4 border-b border-crema/15 pb-4">
            <h3 class="font-display text-3xl uppercase tracking-wide md:text-4xl">{v.data.title}</h3>
            <span class="text-xs font-bold uppercase tracking-[0.2em] text-turquesa">{v.data.position}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('#cine .tab');
  const cards = [...document.querySelectorAll<HTMLElement>('#cine .card')];

  tabs.forEach((t) =>
    t.addEventListener('click', () => {
      tabs.forEach((o) => o.setAttribute('aria-selected', String(o === t)));
      const visible = cards.filter((c) => c.dataset.position === t.dataset.tab);
      cards.forEach((c) => {
        c.classList.toggle('hidden', !visible.includes(c));
        // El primero de cada posición se muestra a ancho completo como destacado.
        c.classList.toggle('md:col-span-2', c === visible[0]);
      });
    }),
  );

  // El iframe se crea al hacer click: cargar varios reproductores de YouTube
  // al inicio haría la página mucho más pesada.
  document.querySelectorAll<HTMLButtonElement>('#cine .yt').forEach((b) =>
    b.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${b.dataset.id}?autoplay=1`;
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 h-full w-full';
      iframe.title = b.getAttribute('aria-label') ?? 'YouTube';
      b.replaceWith(iframe);
    }),
  );
</script>
