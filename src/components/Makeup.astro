---
import { getCollection } from 'astro:content';
import { asset } from '../data/asset';
import { getLang, localized, useT } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const [titleA, titleB] = useT(lang)('makeup.title');

const looks = (await getCollection('makeup')).sort((a, b) => a.data.order - b.data.order);
const photos = looks.flatMap((l) => l.data.photos.map((src) => ({ src: asset(src), title: localized(l.data, 'title', lang) })));
---

<section id="maquillaje" class="bg-marron py-24 text-crema md:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <h2 class="font-display text-[clamp(4.5rem,13vw,10rem)] uppercase leading-[0.8] tracking-wide">
      {titleA}<span class="text-crema-oscuro/60">{titleB}</span>
    </h2>
    <div class="mt-4 flex h-[6px] w-40" aria-hidden="true">
      <span class="flex-1 bg-verde"></span><span class="flex-1 bg-crema"></span><span class="flex-1 bg-turquesa"></span>
    </div>

    <!-- Columnas CSS: cada foto conserva su proporción original, como un mural. -->
    <div class="mt-12 columns-2 gap-3 md:columns-3 md:gap-4 lg:columns-4">
      {photos.map((p, i) => (
        <button
          class="group relative mb-3 block w-full break-inside-avoid overflow-hidden md:mb-4"
          data-lightbox={p.src}
          aria-label={`${p.title} ${i + 1}`}
        >
          <img src={p.src} alt={p.title} decoding="async" class="w-full transition duration-700 group-hover:scale-105" />
          <span class="absolute inset-x-0 bottom-0 translate-y-full bg-negro/80 px-3 py-2 text-left font-display text-xl uppercase tracking-wide transition-transform duration-300 group-hover:translate-y-0">
            {p.title}
          </span>
        </button>
      ))}
    </div>
  </div>
</section>
