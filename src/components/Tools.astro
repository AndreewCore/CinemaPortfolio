---
import { tools } from '../data/tools';

const svgs = import.meta.glob<string>('../assets/logos/*.svg', { query: '?raw', import: 'default', eager: true });

/**
 * Devuelve el SVG del logo listo para incrustar: sin <title> ni tamaño fijo y
 * pintado con currentColor, para que el color lo controle el CSS (hover).
 */
function inlineLogo(name: string): string {
  const raw = svgs[`../assets/logos/${name}.svg`] ?? '';
  return raw
    .replace(/<title>.*?<\/title>/, '')
    .replace(/\s(width|height)="[^"]*"/g, '')
    .replace('<svg', '<svg fill="currentColor" aria-hidden="true" class="h-full w-full"');
}
---

<section id="herramientas" class="bg-negro text-crema">
  <ul class="mx-auto flex max-w-7xl flex-wrap justify-center gap-x-6 gap-y-6 px-4 py-8 sm:px-6 lg:gap-x-8">
    {tools.map((t) => (
      <li class="group flex w-16 flex-col items-center gap-2 text-center sm:w-20">
        <span class="h-9 w-9 text-crema/70 transition-colors group-hover:text-turquesa sm:h-10 sm:w-10" set:html={inlineLogo(t.logo)} />
        <span class="text-[10px] font-bold uppercase leading-tight tracking-[0.12em] text-crema/50 transition-colors group-hover:text-crema">
          {t.name}
        </span>
      </li>
    ))}
  </ul>
</section>
