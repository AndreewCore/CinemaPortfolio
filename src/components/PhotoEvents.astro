---
import { getCollection } from 'astro:content';
import { asset } from '../data/asset';

const events = (await getCollection('events'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .filter((e) => e.data.photos.length > 0);

// El primer elemento es el grande del bento; el resto ocupa una celda.
const spans = ['col-span-2 row-span-2', '', '', '', ''];
const fmt = new Intl.DateTimeFormat('es', { month: 'short', year: 'numeric' });
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="fotografia" class="relative overflow-hidden py-24">
  <span class="pointer-events-none absolute -right-6 top-6 select-none font-display text-[22vw] leading-none text-verde/[0.06]" aria-hidden="true">Foto</span>

  <div class="relative mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[320px_1fr]">
    <div class="min-w-0">
      <h2 class="font-display text-7xl uppercase leading-none tracking-wide">
        Foto<span class="text-verde">grafía</span>
      </h2>
      <div class="mt-2 h-[6px] w-20 bg-marron"></div>

      <ol class="mt-10 flex gap-3 overflow-x-auto pb-2 [scrollbar-width:none] lg:flex-col lg:gap-1 lg:overflow-visible">
        {events.map((e, i) => (
          <li class="shrink-0">
            <button class="ev group w-full min-w-48 py-3 text-left" data-i={i} aria-current={i === 0 ? 'true' : undefined}>
              <span class="flex items-baseline gap-3">
                <span class="font-display text-2xl text-marron">{pad(i + 1)}</span>
                <span class="font-display text-2xl uppercase tracking-wide text-negro/40 transition-colors group-hover:text-negro group-aria-[current]:text-negro">
                  {e.data.title}
                </span>
              </span>
              <span class="mt-2 block h-[3px] overflow-hidden bg-negro/10">
                <span class="bar block h-full w-0 bg-verde"></span>
              </span>
            </button>
          </li>
        ))}
      </ol>
    </div>

    <div class="min-w-0">
      <div class="mb-4 flex items-center justify-between gap-4">
        <p class="text-sm font-bold uppercase tracking-[0.25em] text-marron">
          <span id="event-date">{events[0] && fmt.format(events[0].data.date)}</span>
        </p>
        {events.length > 1 && (
          <div class="flex gap-2">
            <button id="ev-prev" class="grid h-11 w-11 place-items-center rounded-full border-2 border-negro transition hover:bg-negro hover:text-crema" aria-label="Anterior">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 6l-6 6 6 6" /></svg>
            </button>
            <button id="ev-next" class="grid h-11 w-11 place-items-center rounded-full bg-negro text-crema transition hover:bg-verde" aria-label="Siguiente">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 6l6 6-6 6" /></svg>
            </button>
          </div>
        )}
      </div>

      <div id="events" class="grid">
        {events.map((e, i) => (
          <div
            class:list={[
              'event grid aspect-[2/3] grid-cols-2 grid-rows-3 gap-2 transition-opacity duration-700 [grid-area:1/1] sm:gap-3 md:aspect-[16/9] md:grid-cols-4 md:grid-rows-2',
              i === 0 ? 'opacity-100' : 'pointer-events-none opacity-0',
            ]}
            data-date={fmt.format(e.data.date)}
            aria-hidden={i !== 0 ? 'true' : undefined}
          >
            {e.data.photos.slice(0, 5).map((src, j) => (
              <button class:list={['photo group relative overflow-hidden bg-crema-oscuro', spans[j]]} data-src={asset(src)} aria-label={`Ampliar ${e.data.title} ${j + 1}`}>
                <img
                  src={asset(src)}
                  alt={`${e.data.title} ${j + 1}`}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                />
                <span class="absolute inset-0 bg-verde/0 transition-colors group-hover:bg-verde/15"></span>
              </button>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>

  <dialog id="lightbox" class="m-auto max-h-[92vh] max-w-[92vw] bg-transparent p-0 backdrop:bg-negro/90">
    <img id="lightbox-img" src="" alt="" class="max-h-[92vh] max-w-[92vw] object-contain" />
  </dialog>
</section>

<script>
  const INTERVAL = 10_000;
  const root = document.getElementById('events');
  const layers = [...document.querySelectorAll<HTMLElement>('#events .event')];
  const items = [...document.querySelectorAll<HTMLButtonElement>('#fotografia .ev')];
  const date = document.getElementById('event-date')!;

  let current = 0;
  let elapsed = 0;
  let last = performance.now();
  let paused = false;

  /** Muestra el evento `i` (con vuelta circular) y reinicia el contador. */
  function show(i: number) {
    i = (i + layers.length) % layers.length;
    layers.forEach((l, k) => {
      const on = k === i;
      l.classList.toggle('opacity-100', on);
      l.classList.toggle('opacity-0', !on);
      l.classList.toggle('pointer-events-none', !on);
      l.toggleAttribute('aria-hidden', !on);
    });
    items.forEach((b, k) => (k === i ? b.setAttribute('aria-current', 'true') : b.removeAttribute('aria-current')));
    date.textContent = layers[i].dataset.date ?? '';
    current = i;
    elapsed = 0;
  }

  /** Avanza el tiempo y pinta la barra de progreso del evento activo. */
  function tick(now: number) {
    if (!paused) elapsed += now - last;
    last = now;
    if (elapsed >= INTERVAL) show(current + 1);
    items.forEach((b, k) => {
      const bar = b.querySelector<HTMLElement>('.bar')!;
      bar.style.width = k === current ? `${(elapsed / INTERVAL) * 100}%` : '0%';
    });
    requestAnimationFrame(tick);
  }

  if (layers.length > 1 && root) {
    items.forEach((b) => b.addEventListener('click', () => show(Number(b.dataset.i))));
    document.getElementById('ev-prev')?.addEventListener('click', () => show(current - 1));
    document.getElementById('ev-next')?.addEventListener('click', () => show(current + 1));
    // Pausar al pasar el cursor da tiempo de ver las fotos sin que cambien.
    root.addEventListener('mouseenter', () => (paused = true));
    root.addEventListener('mouseleave', () => (paused = lightbox.open));
    requestAnimationFrame(tick);
  }

  const lightbox = document.getElementById('lightbox') as HTMLDialogElement;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  document.querySelectorAll<HTMLButtonElement>('#events .photo').forEach((b) =>
    b.addEventListener('click', () => {
      lightboxImg.src = b.dataset.src ?? '';
      lightboxImg.alt = b.getAttribute('aria-label') ?? '';
      paused = true;
      lightbox.showModal();
    }),
  );
  // Cualquier click cierra: no hay controles dentro que proteger.
  lightbox.addEventListener('click', () => lightbox.close());
  lightbox.addEventListener('close', () => (paused = false));
</script>
