---
import '../styles/global.css';
import { asset } from '../data/asset';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLang, languages } from '../i18n/ui';

interface Props {
  title?: string;
}
const { title = 'Edith Jordan' } = Astro.props;
const lang = getLang(Astro.currentLocale);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
    <title>{title}</title>
    <!-- Antes de pintar: evita el destello de tema equivocado al cargar. -->
    <script is:inline>
      (() => {
        const saved = () => {
          try { return localStorage.getItem('theme'); } catch { return null; }
        };
        const media = matchMedia('(prefers-color-scheme: dark)');
        const apply = () => {
          const s = saved();
          document.documentElement.dataset.theme = s === 'dark' || s === 'light' ? s : media.matches ? 'dark' : 'light';
        };
        apply();
        // Sin elección guardada, sigue al sistema también si cambia con la página abierta.
        media.addEventListener('change', apply);
      })();
    </script>
    {Object.keys(languages).map((l) => <link rel="alternate" hreflang={l} href={getRelativeLocaleUrl(l)} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Manrope:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
